go_package = "main"

tool test_omitempty {
    description "Test omitempty functionality"
    
    input {
        required_field: string "Required field" required
        optional_field: string "Optional field"
        array_field: [string] "Array field"
        object_field: object "Object field"
    }
    
    output {
        required_output: string "Required output field" required
        optional_output: string "Optional output field"
    }
}
